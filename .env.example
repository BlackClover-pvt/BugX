# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Get a free key at https://aistudio.google.com/)
GOOGLE_GEMINI_KEY=your_gemini_api_key_here

# PostgreSQL Database Connection (Local or Neon/Supabase Free Tier)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codereview

# Session Secret (Random secure string)
SESSION_SECRET=super_secret_session_key_min_32_characters_long

# Frontend URL (For CORS and Session Cookie origin)
CLIENT_URL=http://localhost:5173

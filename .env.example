# ==============================================================================
# BugX - Environment Variables Configuration
# ==============================================================================
# Instructions for new contributors / developers cloning from GitHub:
# 1. Copy this file to the BackEnd folder:
#      cp .env.example BackEnd/.env
# 2. Fill in the required credentials below (Gemini API key & PostgreSQL URL).
# 3. Inside BackEnd/, run database migrations:
#      npm run db:generate
#      npm run db:migrate
# 4. Start the development servers:
#      In BackEnd/:  npm run dev
#      In FrontEnd/: npm run dev
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Port for the Express backend server
PORT=3000

# Environment mode: 'development' or 'production'
# Note: In 'production', session cookies enforce HTTPS (secure: true)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Key (REQUIRED)
# ------------------------------------------------------------------------------
# Used by the AI service (gemini-2.5-flash) to perform automated code reviews.
# Get a free API key at: https://aistudio.google.com/
GOOGLE_GEMINI_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Connection (REQUIRED)
# ------------------------------------------------------------------------------
# Required for Drizzle ORM, user auth (accounts/credentials), and persistent sessions.
#
# Option A - Local PostgreSQL:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codereview
#
# Option B - Cloud Hosted (Supabase / Neon / Render / ElephantSQL):
#   DATABASE_URL=postgresql://postgres.your_project_id:your_password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codereview

# ------------------------------------------------------------------------------
# 4. Session Security (REQUIRED)
# ------------------------------------------------------------------------------
# Secret key used by express-session to sign the session ID cookie.
# Must be a secure, random string (at least 32 characters recommended).
# Generate one using terminal: openssl rand -hex 32
SESSION_SECRET=super_secret_session_key_min_32_characters_long

# ------------------------------------------------------------------------------
# 5. Client / Frontend URL (REQUIRED)
# ------------------------------------------------------------------------------
# URL of the Vite frontend application.
# Configures CORS origin and allows credentialed cookies (withCredentials: true).
CLIENT_URL=http://localhost:5173
